  <ItemGroup>
    <ProjectReference Include="..\Lupira.Auth.DevUser\Lupira.Auth.DevUser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lupira.Auth.Jwt.UnitTests" />
  </ItemGroup>

</Project>
