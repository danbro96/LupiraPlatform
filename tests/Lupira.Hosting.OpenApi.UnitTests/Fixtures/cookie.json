            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "traceId": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "RFC 9457 problem details."
      },
      "WidgetDto": {
        "required": [
          "id",
          "status",
          "previousStatus",
          "updatedAt",
          "retiredAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/WidgetStatus"
          },
          "previousStatus": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/WidgetStatus"
              }
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "retiredAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "WidgetSort": {
        "enum": [
          "Newest",
          "Oldest",
          null
        ]
      },
      "WidgetStatus": {
        "enum": [
          "Active",
          "Retired"
        ]
      }
    },
    "securitySchemes": {
      "Cookie": {
        "type": "apiKey",
        "description": "Session cookie minted by the BFF's OIDC login.",
        "name": "__Host-widgets",
        "in": "cookie"
      }
