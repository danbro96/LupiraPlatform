{
  "name": "lupira-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "tsc -b --clean && rm -rf packages/*/dist packages/*/node_modules/.tmp",
    "build": "tsc -b && node scripts/react-compile.mjs",
    "typecheck": "tsc -b --force && tsc -p tsconfig.test.json",
    "lint": "npm run build && npm run lint --workspaces --if-present",
    "test": "npm run build && vitest run",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@expo/vector-icons": "15.1.1",
    "@maplibre/maplibre-react-native": "11.5.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "7.5.1",
    "@sentry/react-native": "8.34.0",
    "@tanstack/query-async-storage-persister": "5.103.2",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-query-persist-client": "5.103.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo": "58.0.23",
    "expo-auth-session": "58.0.17",
    "expo-background-task": "58.0.12",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-haptics": "58.0.7",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.15",
    "expo-task-manager": "58.0.13",
    "expo-updates": "58.0.21",
    "maplibre-gl": "6.11.2",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-paper": "5.15.4",
    "react-native-safe-area-context": "5.11.1",
    "react-router": "7.18.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "zustand": "5.0.15"
  },
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=11.10.0"
  },
  "allowScripts": {
    "@sentry/cli": false,
    "unrs-resolver": false
  }
}
